{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "crons": [{
    "path": "/api/cron/archive-daily-staff-logs",
    "schedule": "0 16 * * *"
  }, {
    "path": "/api/cron/rotate-appointment-slots",
    "schedule": "2 16 * * *"
  }, {
    "path": "/api/cron/sync-daily-staff-stats",
    "schedule": "1 16 * * *"
  }, {
    "path": "/api/cron/sync-coupon-statuses",
    "schedule": "3 16 * * *"
  }, {
    "path": "/api/cron/appointment-reminders",
    "schedule": "45 0-8 * * *"
  }, {
    "path": "/api/cron/appointment-reminders",
    "schedule": "15 1-8 * * *"
  }]
}